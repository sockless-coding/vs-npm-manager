<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
  <Grid Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
        TextElement.Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}">
    <Grid.Resources>
      <Style TargetType="Button" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}" />
      <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
      <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ComboBoxStyleKey}}" />
      <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.CheckBoxStyleKey}}" />
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
      </Style>
    </Grid.Resources>

    <Grid Margin="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Toolbar -->
      <Grid Grid.Row="0" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" MinHeight="24" VerticalContentAlignment="Center"
                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CheckBox Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Content="Prerelease"
                  IsChecked="{Binding IncludePrerelease, Mode=TwoWay}" />
        <ComboBox Grid.Column="2" Margin="8,0,0,0" MinWidth="130"
                  ItemsSource="{Binding Registries}" SelectedItem="{Binding SelectedRegistry, Mode=TwoWay}" />
      </Grid>

      <!-- Tabs -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
        <Button Content="Browse" MinWidth="66" Command="{Binding SelectTabCommand}" CommandParameter="browse" />
        <Button MinWidth="92" Margin="4,0,0,0" Command="{Binding SelectTabCommand}" CommandParameter="installed"
                Content="{Binding InstalledTabLabel}" />
        <Button MinWidth="92" Margin="4,0,0,0" Command="{Binding SelectTabCommand}" CommandParameter="updates"
                Content="{Binding UpdatesTabLabel}" />
        <Button MinWidth="110" Margin="4,0,0,0" Command="{Binding SelectTabCommand}" CommandParameter="consolidate"
                Content="{Binding ConsolidateTabLabel}" />
        <CheckBox Margin="12,0,0,0" VerticalAlignment="Center" Content="Transitive"
                  Visibility="{Binding TransitiveToggleVisibility}"
                  IsChecked="{Binding IncludeTransitive, Mode=TwoWay}" />
        <Button Margin="12,0,0,0" Content="Update All" Visibility="{Binding UpdateAllVisibility}"
                Command="{Binding UpdateAllCommand}" />
        <Button Margin="12,0,0,0" Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding NotBusy}" />
      </StackPanel>

      <TextBlock Grid.Row="2" Text="{Binding Notice}" TextWrapping="Wrap" Margin="0,0,0,4"
                 Visibility="{Binding NoticeVisibility}"
                 Foreground="{DynamicResource {x:Static styles:VsBrushes.ControlLinkTextKey}}" />

      <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,0,0,6" TextWrapping="Wrap" Opacity="0.85" />

      <!-- Content -->
      <Grid Grid.Row="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" MinWidth="200" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="3*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
          <Button DockPanel.Dock="Bottom" Content="Load more" Margin="0,4,0,0"
                  Visibility="{Binding LoadMoreVisibility}" Command="{Binding LoadMoreCommand}" />
          <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                   HorizontalContentAlignment="Stretch"
                   Style="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogListBoxStyleKey}}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.85" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Badges}" FontSize="11"
                               Foreground="{DynamicResource {x:Static styles:VsBrushes.ControlLinkTextKey}}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding RightLabel}" VerticalAlignment="Center"
                             Margin="6,0,0,0" FontFamily="Consolas" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Detail -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Select a package to see details." Opacity="0.7" Margin="8"
                       Visibility="{Binding NoDetailVisibility}" />

            <StackPanel Margin="6" Visibility="{Binding DetailVisibility}" DataContext="{Binding Detail}">
              <TextBlock Text="{Binding Id}" FontSize="15" FontWeight="Bold" />
              <TextBlock Text="{Binding Subtitle}" Opacity="0.85" Margin="0,2,0,8" TextWrapping="Wrap" />

              <ItemsControl ItemsSource="{Binding Callouts}" Visibility="{Binding CalloutsVisibility}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,4" Padding="6" BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}">
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Margin="0,0,0,6" Padding="6" BorderThickness="1"
                      Visibility="{Binding FreshWarningVisibility}"
                      BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}">
                <TextBlock Text="{Binding FreshWarning}" TextWrapping="Wrap" />
              </Border>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <StackPanel Margin="0,0,10,0">
                  <TextBlock Text="Version" FontSize="11" Opacity="0.85" />
                  <ComboBox MinWidth="240" ItemsSource="{Binding VersionOptions}"
                            DisplayMemberPath="Display" SelectedValuePath="Version"
                            SelectedValue="{Binding SelectedVersion, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0" Visibility="{Binding SaveAsVisibility}">
                  <TextBlock Text="Save as" FontSize="11" Opacity="0.85" />
                  <ComboBox MinWidth="170" ItemsSource="{Binding SaveAsOptions}" SelectedItem="{Binding SelectedSaveAs, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Visibility="{Binding AddAsVisibility}">
                  <TextBlock Text="Add as" FontSize="11" Opacity="0.85" />
                  <ComboBox MinWidth="140" ItemsSource="{Binding AddAsOptions}" SelectedItem="{Binding SelectedAddAs, Mode=TwoWay}" />
                </StackPanel>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Install" MinWidth="60" IsEnabled="{Binding CanInstall}" Command="{Binding InstallCommand}" />
                <Button Content="Update" MinWidth="60" Margin="4,0,0,0" IsEnabled="{Binding CanUpdate}" Command="{Binding UpdateCommand}" />
                <Button Content="Pin" MinWidth="48" Margin="4,0,0,0" IsEnabled="{Binding CanPin}" Command="{Binding PinCommand}" />
                <Button Content="Unpin" MinWidth="52" Margin="4,0,0,0" IsEnabled="{Binding CanUnpin}" Command="{Binding UnpinCommand}" />
                <Button Content="Uninstall" MinWidth="66" Margin="4,0,0,0" IsEnabled="{Binding CanUninstall}" Command="{Binding UninstallCommand}" />
              </StackPanel>

              <TextBlock Text="package.json" FontWeight="Bold" Margin="0,0,0,2" />
              <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Name}" />
                      <TextBlock Grid.Column="1" Text="{Binding InstalledVersion}" FontFamily="Consolas" Opacity="0.9" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,8,0,0"
                         Visibility="{Binding DescriptionVisibility}" />

              <Button Content="Project site" Margin="0,6,0,0" HorizontalAlignment="Left"
                      Visibility="{Binding ProjectUrlVisibility}" Command="{Binding OpenProjectUrlCommand}" />

              <Expander Header="Known vulnerabilities" Margin="0,8,0,0" IsExpanded="True"
                        Visibility="{Binding AdvisoriesVisibility}">
                <ItemsControl ItemsSource="{Binding Advisories}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>

              <Expander Header="Dependencies" Margin="0,4,0,0" Visibility="{Binding DependencyGroupsVisibility}">
                <ItemsControl ItemsSource="{Binding DependencyGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>

              <Expander Header="Readme" Margin="0,4,0,0" Visibility="{Binding ReadmeVisibility}">
                <TextBox Text="{Binding ReadmeText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         MaxHeight="360" VerticalScrollBarVisibility="Auto" FontSize="12" />
              </Expander>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Toast -->
      <Border Grid.Row="5" Margin="0,6,0,0" Padding="6" BorderThickness="1"
              Visibility="{Binding ToastVisibility}"
              BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Toast}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissToastCommand}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</DataTemplate>
